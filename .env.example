# ==============================================================================
# ZensusTech Application Configuration
# Copy this file to .env and fill in your actual values.
# On Render: Add these under your Web Service -> Environment Variables.
# ==============================================================================

# Database Configuration (PostgreSQL)
# Locally: postgresql://postgres:root@localhost:5432/zensustech
# On Render: Internal/External Database URL provided by Render PostgreSQL
DATABASE_URL=postgresql://postgres:root@localhost:5432/zensustech

# Email delivery through the Microsoft Graph HTTP API (no SMTP password).
# Register an Entra ID app, grant Microsoft Graph Application permission
# Mail.Send with admin consent, and use a mailbox address for GRAPH_MAIL_SENDER.
AZURE_TENANT_ID=your-tenant-id
AZURE_CLIENT_ID=your-application-client-id
AZURE_CLIENT_SECRET=your-application-client-secret
GRAPH_MAIL_SENDER=noreply@your-domain.com

# Server Configuration
PORT=8010
HOST=0.0.0.0
