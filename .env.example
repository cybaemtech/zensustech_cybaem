# ==============================================================================
# ZensusTech Application Configuration
# Copy this file to .env and fill in your actual values.
# On Render / Production: Set these under your Web Service -> Environment.
# ==============================================================================

# Database Configuration (PostgreSQL)
# Locally: postgresql://postgres:root@localhost:5432/zensustech
# On Render: Internal/External Database URL provided by Render PostgreSQL
DATABASE_URL=postgresql://postgres:root@localhost:5432/zensustech

# Email (SMTP) Configuration for OTP Verification
# The OTP is sent strictly to the user's email address and is NEVER shown on screen.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-16-char-app-password
SMTP_FROM=ZensusTech <no-reply@zensustech.com>

# Server Configuration
PORT=8010
HOST=0.0.0.0

