# ==============================================================================
# ZensusTech Application Configuration
# Copy this file to .env and fill in your actual values.
# On Render: Add these under your Web Service -> Environment Variables.
# ==============================================================================

# Database Configuration (PostgreSQL)
# Locally: postgresql://postgres:root@localhost:5432/zensustech
# On Render: Internal/External Database URL provided by Render PostgreSQL
DATABASE_URL=postgresql://postgres:root@localhost:5432/zensustech

# Email (SMTP) Configuration for Microsoft 365 / Office 365
# Required to send verification codes to inboxes from noreply@zensustech.com or noreply@cybaemtech.com
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=noreply@zensustech.com
SMTP_PASS=your-mailbox-password-or-app-password
SMTP_FROM=ZensusTech <noreply@zensustech.com>

# Server Configuration
PORT=8010
HOST=0.0.0.0
