DATABASE_URL=postgresql://postgres:root@localhost:5432/zensustech

# Microsoft Graph app-only mail delivery. Grant Microsoft Graph application
# permission Mail.Send and admin consent; GRAPH_MAIL_SENDER must be a mailbox.
# Keep actual credentials in backend/.env; never commit them.
AZURE_TENANT_ID=your-tenant-id
AZURE_CLIENT_ID=your-application-client-id
AZURE_CLIENT_SECRET=your-application-client-secret
GRAPH_MAIL_SENDER=noreply@your-domain.com

PORT=8010
HOST=0.0.0.0
