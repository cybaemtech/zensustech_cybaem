{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "dev": "pnpm --filter @workspace/zensus-tech-login run dev",
    "dev:login": "pnpm --filter @workspace/zensus-tech-login run dev",
    "dev:enhanced": "npm --prefix Zensustech-feature-enhanced-dashboard/frontend run dev",
    "dev:backend": "powershell -NoExit -Command \"cd Zensustech-feature-enhanced-dashboard/backend; .venv/Scripts/Activate.ps1; fastapi dev app/main.py\"",
    "start:enhanced": "powershell -ExecutionPolicy Bypass -File Zensustech-feature-enhanced-dashboard/start.ps1",
    "build": "pnpm run typecheck && pnpm -r --if-present run build",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck",
    "dev:api": "python -m uvicorn app.main:app --app-dir backend --host 0.0.0.0 --port 8010"
  },
  "private": true,
  "dependencies": {
    "@replit/connectors-sdk": "^0.4.3"
  },
  "devDependencies": {
    "prettier": "^3.9.6",
    "typescript": "~5.9.3"
  }
}
